{
  "name": "dgh-fpl-dominator",
  "version": "3.7.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "cross-env EXPO_USE_METRO_WORKSPACE_ROOT=1 npx expo start --web --port ${EXPO_PORT:-8081}",
    "start": "expo start",
    "check": "tsc --noEmit",
    "lint": "expo lint",
    "format": "prettier --write .",
    "test": "npm run test:logic",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "qr": "node scripts/generate_qr.mjs",
    "build:android": "eas build --platform android --profile production",
    "build:apk": "eas build --platform android --profile release-apk",
    "validate": "npm run check && npm run validate:source && npm run validate:performance && npm run test:logic",
    "release:check": "npm run preflight && npm run validate",
    "preflight": "node scripts/release-preflight.js",
    "validate:source": "node scripts/validate-source.js",
    "validate:performance": "node scripts/performance-preflight.js",
    "test:logic": "vitest run tests/logic.test.ts tests/spy.test.ts tests/compare-and-strength.test.ts tests/chip-timing.test.ts tests/live-status.test.ts tests/mini-league-template-and-tes.test.ts tests/uti.test.ts tests/manager-lookup.test.ts tests/validation.test.ts tests/filters.test.ts",
    "test:integration": "vitest run tests/expo-token.test.ts"
  },
  "overrides": {
    "rollup": "4.53.5"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@tanstack/react-query": "^5.90.12",
    "clsx": "^2.1.1",
    "expo": "~54.0.29",
    "expo-background-task": "~1.0.10",
    "expo-build-properties": "^1.0.10",
    "expo-constants": "~18.0.12",
    "expo-file-system": "~19.0.16",
    "expo-linking": "8.0.12",
    "expo-font": "~14.0.10",
    "expo-linear-gradient": "~15.0.7",
    "expo-notifications": "~0.32.15",
    "expo-router": "~6.0.19",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.12",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-task-manager": "~14.0.9",
    "nativewind": "^4.2.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-css-interop": "0.2.6",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.6",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.5.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.1.17",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~10.0.0",
    "globals": "^17.12.0",
    "prettier": "^3.7.4",
    "qrcode": "^1.5.4",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "vitest": "^2.1.9",
    "babel-preset-expo": "54.0.12"
  },
  "packageManager": "pnpm@9.12.0"
}
