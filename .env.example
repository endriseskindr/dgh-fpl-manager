# Standalone Android build: no backend URL is required.
# FPL data is fetched directly from the official FPL API by lib/fplClient.ts.
# Do not place secrets or FPL authentication tokens in EXPO_PUBLIC_* variables.

# Optional EAS project association. Set this per build/account instead of hard-coding it in app.config.ts.
# EAS_PROJECT_ID=your-eas-project-id
